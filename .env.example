const brand = {
  name: 'Strydë',
  paymentMethods: ['Visa', 'Mastercard', 'Apple Pay', 'PayPal', 'Klarna']
};

function ensureDataFile(fileName) {
  const filePath = path.join(DATA_DIR, fileName);
  if (!fs.existsSync(filePath)) {
    fs.writeFileSync(filePath, JSON.stringify([], null, 2), 'utf8');
  }
  return filePath;
}

function readJson(fileName) {
  const filePath = ensureDataFile(fileName);
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } catch {
    return [];
  }
}

function writeJson(fileName, data) {
  const filePath = ensureDataFile(fileName);
  fs.writeFileSync(filePath, JSON.stringify(data, null, 2), 'utf8');
}

app.use(express.json({ limit: '1mb' }));
app.use(express.urlencoded({ extended: true }));
app.use(express.static(__dirname));

app.get('/api/health', (_req, res) => {
  res.json({ ok: true, name: brand.name });
});

app.get('/api/config', (_req, res) => {
  res.json({
    brandName: brand.name,
    paymentMethods: PAYMENT_METHODS,
    stripePublishableKey: process.env.STRIPE_PUBLISHABLE_KEY || null,
    mode: stripe ? 'live' : 'demo'
  });
});

app.get('/api/products', (_req, res) => {
  res.json(products);
});

app.post('/api/newsletter', (req, res) => {
  const { email } = req.body || {};
  if (!email) {
    return res.status(400).json({ error: 'Email required' });
  }

  const entries = readJson('newsletter.json');
  entries.push({ email, createdAt: new Date().toISOString() });
  writeJson('newsletter.json', entries);
  return res.json({ success: true });
});

app.post('/api/support', (req, res) => {
  const payload = req.body || {};
  if (!payload.name || !payload.email || !payload.message) {
    return res.status(400).json({ error: 'Name, email and message are required' });
  }

  const entries = readJson('support.json');
  entries.push({ ...payload, createdAt: new Date().toISOString() });
  writeJson('support.json', entries);
  return res.json({ success: true });
});

app.post('/api/orders', (req, res) => {
  const payload = req.body || {};
  const entries = readJson('orders.json');
  entries.push({ ...payload, createdAt: new Date().toISOString() });
  writeJson('orders.json', entries);
  res.json({ success: true });
});

app.post('/api/create-checkout-session', async (req, res) => {
  const { items = [], customerEmail, shippingName, shippingAddress } = req.body || {};

  if (!stripe) {
    return res.status(500).json({
      error: 'Stripe is not configured. Add STRIPE_SECRET_KEY and STRIPE_PUBLISHABLE_KEY in your .env file.'
    });
  }

  if (!Array.isArray(items) || items.length === 0) {
    return res.status(400).json({ error: 'Cart is empty' });
  }

  const productMap = new Map(products.map((product) => [product.id, product]));

  const lineItems = items.map((item) => {
    const product = productMap.get(item.id);
    if (!product) {
      throw new Error(`Unknown product: ${item.id}`);
    }

    return {
      price_data: {
        currency: 'usd',
        product_data: {
          name: product.name,
          description: product.description
        },
        unit_amount: Math.round(product.price * 100)
      },
      quantity: Number(item.quantity || 1)
    };
  });

  try {
    const session = await stripe.checkout.sessions.create({
      mode: 'payment',
      line_items: lineItems,
      customer_email: customerEmail || undefined,
      payment_method_types: PAYMENT_METHODS.map((method) => {
        if (method === 'visa' || method === 'mastercard' || method === 'applepay') return 'card';
        if (method === 'paypal') return 'paypal';
        if (method === 'klarna') return 'klarna';
        return method;
      }),
      shipping_address_collection: {
        allowed_countries: ['US', 'GB', 'CA', 'AU', 'DE', 'FR', 'ES', 'IT']
      },
      metadata: {
        customerName: shippingName || '',
        shippingAddress: shippingAddress ? JSON.stringify(shippingAddress) : ''
      },
      success_url: `${process.env.PUBLIC_URL || 'http://localhost:3000'}/success.html?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${process.env.PUBLIC_URL || 'http://localhost:3000'}/checkout.html?cancelled=1`
    });

    res.json({ url: session.url });
  } catch (error) {
    console.error('Stripe checkout error:', error);
    res.status(500).json({ error: 'Unable to create checkout session.' });
  }
});

app.get('*', (_req, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

app.listen(PORT, () => {
  console.log(`Strydë storefront running at http://localhost:${PORT}`);
  if (!stripe) {
    console.log('Stripe is not configured. Add STRIPE_SECRET_KEY and STRIPE_PUBLISHABLE_KEY to your .env file to enable live payments.');
  }
});
